{
  "realm": "seguranca",
  "enabled": true,
  "displayName": "MS-AV-02 Seguranca",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMIN",
        "description": "Administrador - desbloqueia usuarios"
      },
      {
        "name": "ROLE_MANUTENCAO",
        "description": "Manutencao - cadastra e lista usuarios"
      }
    ]
  },
  "clients": [
    {
      "clientId": "seguranca-swagger",
      "name": "Swagger UI (Authorization Code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/swagger-ui/index.html"
      }
    }
  ],
  "users": [
    {
