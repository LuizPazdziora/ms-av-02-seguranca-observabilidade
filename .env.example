# Valores SOMENTE de demonstracao - copie para .env e troque as senhas
# (o arquivo .env nao e versionado)

# Banco H2 (a senha e definida na criacao do arquivo do banco; se mudar, recrie o volume com docker compose down -v)
H2_USERNAME=sa
H2_PASSWORD=h2-demo

# Usuarios de demonstracao criados na primeira subida (operadores e usuarios do sistema)
DEMO_ADMIN_PASSWORD=admin-demo
DEMO_MANUTENCAO_PASSWORD=manutencao-demo
DEMO_USUARIOS_PASSWORD=usuario-demo

# Grafana (aplicada somente na primeira criacao do volume grafana-data)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-demo

# Testes sem a execucao dos testes automatizados no build (true/false)
SKIP_TESTS=false

# Extensao OAuth2 (opcional) - Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=keycloak-demo
OAUTH2_ADMIN_PASSWORD=admin-oauth2-demo
OAUTH2_MANUTENCAO_PASSWORD=manutencao-oauth2-demo
